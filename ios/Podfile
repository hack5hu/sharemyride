# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

install! 'cocoapods', :disable_input_output_paths => true

use_modular_headers!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'shareMyRide' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Truecaller native SDK
  pod 'TrueSDK'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # MapLibre React Native post-install hook
    $MLRN.post_install(installer)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end

    # Fix for ReactCodegen duplicate/missing sources bug
    react_codegen_target = installer.pods_project.targets.find { |t| t.name == 'ReactCodegen' }
    if react_codegen_target
      puts "Fixing ReactCodegen target sources..."
      sources_phase = react_codegen_target.source_build_phase
      sources_phase.clear
      
      react_codegen_group = installer.pods_project.objects.select { |o| o.isa == 'PBXGroup' && o.name == 'ReactCodegen' }.first
      if react_codegen_group
        all_source_files = []
        queue = [react_codegen_group]
        while !queue.empty?
          current = queue.shift
          current.children.each do |child|
            if child.isa == 'PBXFileReference'
              if child.path && (child.path.end_with?('.cpp') || child.path.end_with?('.mm') || child.path.end_with?('.c'))
                all_source_files << child
              end
            elsif child.isa == 'PBXGroup'
              queue << child
            end
          end
        end
        
        all_source_files.uniq.each do |file_ref|
          build_file = sources_phase.add_file_reference(file_ref)
          build_file.settings = { 'COMPILER_FLAGS' => '-DFOLLY_MOBILE=1 -DFOLLY_USE_LIBCPP=1 -DFOLLY_CFG_NO_COROUTINES=1 -DFOLLY_HAVE_CLOCK_GETTIME=1 -Wno-comma -Wno-shorten-64-to-32 -Wno-documentation -Wno-nullability-completeness -std=c++20' }
        end
        puts "ReactCodegen source build phase updated to #{sources_phase.files.count} files."
      else
        puts "Error: ReactCodegen group not found!"
      end
    end

    # Workaround for "Multiple commands produce Assets.car"
    installer.aggregate_targets.each do |target|
      copy_resources_path = "Pods/Target Support Files/#{target.name}/#{target.name}-resources.sh"
      if File.exist?(copy_resources_path)
        content = File.read(copy_resources_path)
        content = content.gsub(/.*Assets\.xcassets.*/, "")
        File.write(copy_resources_path, content)
      end
    end
  end
end
